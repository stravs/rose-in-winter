---
// Site layout: Tailwind only. BaseLayout's unlayered global.css would override Tailwind utilities.
import { translator, localeFromPath, localePath, locales, pathWithoutLocale } from '../i18n';
const locale = localeFromPath(Astro.url.pathname);
const t = translator(locale);
import '../styles/site.css';
import { getSiteConfig } from '../config/site';

interface Props {
  title: string;
  description: string;
  canonical: string;
  image?: string | undefined;
  jsonLd?: Record<string, unknown> | undefined;
}

const { title, description, canonical, image, jsonLd } = Astro.props;
const siteConfig = await getSiteConfig();
// design.colors overrides the @theme defaults in site.css.
const c = siteConfig.design.colors;
const palette = `--color-dark:${c.primary};--color-accent:${c.accent};--color-bg:${c.background};--color-soft:${c.surface};--color-ink:${c.text};--color-muted:${c.muted}`;
---
<!doctype html>
<html lang={locale} style={palette}>
  <head>
    <meta charset="UTF-8" />
    <script is:inline>document.documentElement.classList.add('js')</script>
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {locales.map(language => <link rel="alternate" hreflang={language} href={new URL(localePath(language, pathWithoutLocale(Astro.url.pathname)), canonical).href} />)}
    <link rel="alternate" hreflang="x-default" href={new URL(localePath('en', pathWithoutLocale(Astro.url.pathname)), canonical).href} />
    <link rel="preload" href="/fonts/newsreader.woff2" as="font" type="font/woff2" crossorigin />
    <meta name="theme-color" content={c.primary} />
    {siteConfig.site.preview && <meta name="robots" content="noindex,nofollow" />}
    <meta property="og:type" content="website" />
    <meta property="og:locale" content={{ en: 'en_GB', sl: 'sl_SI', de: 'de_DE', it: 'it_IT' }[locale]} />
    {locales.filter(language => language !== locale).map(language => <meta property="og:locale:alternate" content={{ en: 'en_GB', sl: 'sl_SI', de: 'de_DE', it: 'it_IT' }[language]} />)}
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    {image && <meta property="og:image" content={new URL(image, canonical).href} />}
    <meta name="twitter:card" content="summary_large_image" />
    {/* Escape "<" so scraped text containing "</script>" cannot end the tag. */}
    {jsonLd && <script is:inline type="application/ld+json" set:html={JSON.stringify(jsonLd).replaceAll('<', '\\u003c')} />}
  </head>
  <body class="bg-bg text-ink font-sans antialiased">
    <a href="#main" class="sr-only focus:not-sr-only focus:fixed focus:top-3 focus:left-3 focus:z-50 focus:bg-ink focus:text-bg focus:px-4 focus:py-2 focus:rounded-full">{t("Skip to content")}</a>
    <slot />
    <script>
      // Reveal [data-reveal] elements once they scroll into view (styles in site.css).
      const reveal = (el: Element) => el.classList.add('is-visible');
      const targets = document.querySelectorAll('[data-reveal]');
      if ('IntersectionObserver' in window) {
        const observer = new IntersectionObserver((entries) => entries.forEach((entry) => {
          if (!entry.isIntersecting) return;
          reveal(entry.target);
          observer.unobserve(entry.target);
        }), { rootMargin: '0px 0px -8% 0px' });
        targets.forEach((el) => observer.observe(el));
      } else targets.forEach(reveal);
    </script>
  </body>
</html>
