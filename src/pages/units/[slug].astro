---
import SiteLayout from '../../layouts/SiteLayout.astro';
import SiteHeader from '../../components/site/SiteHeader.astro';
import EnquiryForm from '../../components/site/EnquiryForm.astro';
import SiteFooter from '../../components/site/SiteFooter.astro';
import PhotoLightbox from '../../components/site/PhotoLightbox.astro';
import { propertyRepository } from '../../repositories/property-repository';
import { formatBeds, propertyLocation, unitFacts, type Property } from '../../domain/property';
import { unitPath, unitSlug } from '../../domain/unit-path';

export async function getStaticPaths() {
  const property = await propertyRepository.get();
  return property?.units.map((unit) => ({ params: { slug: unitSlug(unit) }, props: { property, unitId: unit.id } })) ?? [];
}

interface Props { property: Property; unitId: string }
const { property, unitId } = Astro.props;
const unit = property.units.find((item) => item.id === unitId)!;
const story = property.narrative;
const rating = property.bookingRating;
const photos = unit.photos;
// Desktop mosaic: cover plus the next four photos; the lightbox has the rest.
const mosaic = photos.slice(0, 5);
const otherUnits = property.units.filter((item) => item.id !== unit.id);
const lake = property.nearby?.find((place) => place.major);
// House-wide highlights (e.g. Kitchen) are shown once below, not again as apartment chips.
const highlightTitles = new Set(story?.highlights?.map((item) => item.title) ?? []);
const amenities = unit.amenities.filter((amenity) => !highlightTitles.has(amenity));

const canonical = new URL(unitPath(unit, 'en'), Astro.site ?? Astro.url.origin).href;
const homeUrl = new URL('/', canonical).href;
const description = `${unit.name} at ${property.name}, ${property.city}. ${unitFacts(unit)}. ${unit.description ?? ''}`.replace(/\s+/g, ' ').trim().slice(0, 158);
const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'Accommodation', name: unit.name, description: unit.description, url: canonical,
      image: photos.map((photo) => new URL(photo.url, canonical).href),
      occupancy: unit.maxGuests ? { '@type': 'QuantitativeValue', maxValue: unit.maxGuests } : undefined,
      floorSize: unit.areaSquareMetres ? { '@type': 'QuantitativeValue', value: unit.areaSquareMetres, unitCode: 'MTK' } : undefined,
      containedInPlace: { '@type': 'LodgingBusiness', name: property.name, url: homeUrl },
    },
    { '@type': 'BreadcrumbList', itemListElement: [
      { '@type': 'ListItem', position: 1, name: property.name, item: homeUrl },
      { '@type': 'ListItem', position: 2, name: unit.name, item: canonical },
    ] },
  ],
};
const photoButton = 'block w-full h-full overflow-hidden bg-soft cursor-zoom-in focus-visible:outline-3 focus-visible:outline-accent';
---
<SiteLayout title={`${unit.name} | ${property.name}`} {description} {canonical} image={photos[0]?.url} {jsonLd}>
  <SiteHeader {property} />

  <main id="main">
    <section class="mx-auto max-w-7xl px-4 sm:px-6 pt-8 pb-10" aria-labelledby="unit-title">
      <a href="/#apartments" class="text-muted hover:text-ink">← All apartments</a>
      <div class="mt-4 flex flex-wrap items-end justify-between gap-4">
        <div>
          <h1 id="unit-title" class="font-serif text-4xl sm:text-6xl leading-[1.02]">{unit.name}</h1>
          <p class="mt-3 text-muted">{unitFacts(unit)}</p>
        </div>
        {rating && <a href="/#reviews" class="flex items-center gap-3"><span class="font-serif text-4xl leading-none">{rating.value.toFixed(1)}</span><span class="text-sm text-muted"><strong class="text-ink">{rating.label}</strong><br />{rating.count} Booking.com reviews</span></a>}
      </div>

      {photos.length > 0 && (
        <>
          <!-- Phones and tablets: swipe through every photo. -->
          <div class="md:hidden mt-6 -mx-4 px-4 flex gap-3 overflow-x-auto snap-x snap-mandatory" tabindex="0" aria-label={`Photos of ${unit.name}, scroll sideways`}>
            {photos.map((photo, index) => (
              <button type="button" data-photo={index} class="snap-center shrink-0 w-[85%] aspect-[4/3] rounded-2xl overflow-hidden bg-soft" aria-label={`Open photo ${index + 1} of ${photos.length}`}>
                <img src={photo.url} srcset={photo.srcSet} sizes="85vw" width={photo.width} height={photo.height} alt={photo.alt ?? ''} loading={index === 0 ? 'eager' : 'lazy'} decoding="async" class="w-full h-full object-cover" />
              </button>
            ))}
          </div>
          <!-- Desktop: cover plus four. -->
          <div class="hidden md:grid mt-8 grid-cols-4 grid-rows-2 gap-3 h-[min(560px,62vh)] rounded-2xl overflow-hidden relative">
            {mosaic.map((photo, index) => (
              <button type="button" data-photo={index} class:list={[photoButton, index === 0 && 'col-span-2 row-span-2']} aria-label={`Open photo ${index + 1} of ${photos.length}`}>
                <img src={photo.url} srcset={photo.srcSet} sizes={index === 0 ? '50vw' : '25vw'} width={photo.width} height={photo.height} alt={photo.alt ?? ''} loading={index === 0 ? 'eager' : 'lazy'} fetchpriority={index === 0 ? 'high' : undefined} decoding="async" class="w-full h-full object-cover transition-transform duration-500 hover:scale-[1.03]" />
              </button>
            ))}
            {photos.length > mosaic.length && <button type="button" data-photo="0" class="absolute right-4 bottom-4 btn bg-white text-ink shadow-lg hover:bg-bg">Show all {photos.length} photos</button>}
          </div>
        </>
      )}
    </section>

    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:grid lg:grid-cols-[1fr_360px] lg:gap-14">
      <div class="min-w-0 pb-16">
        <section aria-labelledby="details-title">
          <h2 id="details-title" class="font-serif text-3xl sm:text-4xl">The apartment</h2>
          {unit.description && <p class="mt-4 text-lg text-muted max-w-2xl">{unit.description}</p>}
          <dl class="mt-8 grid grid-cols-2 sm:grid-cols-4 gap-6">
            {unit.areaSquareMetres && <div><dt class="text-muted">Size</dt><dd class="font-serif text-2xl">{unit.areaSquareMetres} m²</dd></div>}
            {unit.occupancyLabel && <div><dt class="text-muted">Sleeps</dt><dd class="font-serif text-2xl">{unit.occupancyLabel}</dd></div>}
            {unit.rooms.map((room) => room.beds && <div class="col-span-2"><dt class="text-muted">{room.name}</dt><dd class="font-serif text-2xl">{formatBeds(room.beds)}</dd></div>)}
          </dl>
          {amenities.length > 0 && (
            <ul class="mt-8 flex flex-wrap gap-2" aria-label="In the apartment">
              {amenities.map((amenity) => <li class="bg-soft px-4 py-1.5 rounded-full">{amenity}</li>)}
            </ul>
          )}
          <button type="button" data-unit={unit.name} class="lg:hidden mt-8 btn-primary">Enquire about this apartment</button>
        </section>

        {story?.highlights && (
          <section class="mt-16 pt-12 border-t border-ink/10" aria-labelledby="house-title">
            <h2 id="house-title" class="font-serif text-3xl sm:text-4xl">Shared by every apartment</h2>
            <ul class="mt-6 grid grid-cols-2 sm:grid-cols-4 gap-x-6 gap-y-8">
              {story.highlights.map((item) => <li><strong class="block font-serif text-2xl font-normal">{item.title}</strong><span class="mt-1 block text-muted">{item.text}</span></li>)}
            </ul>
            <p class="mt-8 text-muted">
              {propertyLocation(property, { country: false })}{lake && <> · {lake.distance} to {lake.name}</>} · <a href="/#location" class="link text-ink">See the location</a>
            </p>
          </section>
        )}

        {story && (
          <section id="arrival" class="mt-16 pt-12 border-t border-ink/10" aria-labelledby="arrival-title">
            <h2 id="arrival-title" class="font-serif text-3xl sm:text-4xl">Good to know</h2>
            <dl class="mt-6 grid sm:grid-cols-2 gap-x-10 gap-y-6">
              {story.practical.map((item) => <div><dt class="font-semibold">{item.label}</dt><dd class="mt-1 text-muted">{item.value}</dd></div>)}
            </dl>
          </section>
        )}
      </div>

      <EnquiryForm {property} selected={unit.name} class="lg:sticky lg:top-6 mb-16" />
    </div>

    {otherUnits.length > 0 && (
      <section class="bg-soft" aria-labelledby="other-title">
        <div class="mx-auto max-w-7xl px-4 sm:px-6 py-16">
          <h2 id="other-title" class="font-serif text-3xl sm:text-4xl">Other apartments</h2>
          <ul class="mt-8 grid sm:grid-cols-2 lg:grid-cols-4 gap-6">
            {otherUnits.map((other) => {
              const cover = other.photos[0];
              return (
                <li>
                  <a href={unitPath(other, 'en')} class="group block">
                    {cover && <img src={cover.url} srcset={cover.srcSet} sizes="(max-width: 640px) 92vw, (max-width: 1024px) 46vw, 23vw" width={cover.width} height={cover.height} alt="" loading="lazy" decoding="async" class="w-full aspect-[4/3] object-cover rounded-2xl bg-bg" />}
                    <h3 class="mt-4 font-serif text-2xl group-hover:text-accent">{other.name}</h3>
                    <p class="mt-1 text-muted">{unitFacts(other)}</p>
                  </a>
                </li>
              );
            })}
          </ul>
        </div>
      </section>
    )}
  </main>

  <SiteFooter {property} />
  <PhotoLightbox {photos} title={unit.name} />
</SiteLayout>
