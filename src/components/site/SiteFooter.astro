---
import { propertyLocation, type Property } from '../../domain/property';
import Logo from './Logo.astro';
interface Props { property: Property }
const { property } = Astro.props;
---
<footer class="mx-auto max-w-7xl px-4 sm:px-6 py-12 flex flex-wrap items-end justify-between gap-4 text-muted">
  <div><div class="text-ink"><Logo {property} /></div><p class="mt-2">{propertyLocation(property)}</p></div>
  <p class="text-sm">© {new Date().getFullYear()} {property.name}</p>
</footer>

